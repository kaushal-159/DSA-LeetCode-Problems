class Solution {
    public int hammingDistance(int x, int y) {
        String S= Integer.toBinaryString(x);
        String P= Integer.toBinaryString(y);

        int len= Math.max(S.length(), P.length());
        
        S= String.format("%" + len + "s", S).replace(' ','0');
        P= String.format("%" + len + "s", P).replace(' ','0');

        int count=0;

        for(int i=0; i<len; i++){
            if(S.charAt(i)!=P.charAt(i)){
                count++;
            }
        }
        return count;
    }
}
