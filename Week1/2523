class Solution {
    public int[] closestPrimes(int left, int right) {
         int prev=-1;
        int num1=-1;
        int num2=-1;

        int minDiff= Integer.MAX_VALUE;

        for (int i=left; i<=right; i++){
            boolean prime= true;
            if (i<2){
                prime=false;
            }
            for(int j=2; j *j<= i; j++){
                if (i%j== 0) {
                    prime= false;
                    break;
                }
            }
            if(prime){
                if(prev!=-1){
                    int diff= i-prev;

                    if (diff< minDiff){
                        minDiff= diff;
                        num1= prev;
                        num2= i;
                    }
                }
                prev= i;
            }
        }
        return new int[]{num1, num2};
    }
}
